# Copy this file to .env and fill in your values.
# docker-compose auto-loads .env; scripts/deploy.sh sources it too.

# ── Local development only ────────────────────────────────────
# The site will be available at http://localhost:HOST_PORT
HOST_PORT=8080

# ── Deployment target (used by scripts/deploy.sh) ─────────────
# Deploy as the user that OWNS the deploy path (ben), so `git pull` needs no
# sudo and no git safe.directory workaround. root also works but is discouraged.
DEPLOY_HOST=your-droplet-ip-or-hostname
DEPLOY_USER=ben
DEPLOY_PATH=/opt/isitbensbirthday
DEPLOY_BRANCH=main

# ── /dev.html Basic Auth (prod only) ──────────────────────────
# The dev console is gated behind Apache Basic Auth in prod (local dev is open).
# The real credentials live in /etc/apache2/.htpasswd on the droplet; keep a
# copy of the password here so you don't lose it. Generate with:
#   htpasswd -bBc /etc/apache2/.htpasswd ben "$(openssl rand -base64 18)"
DEV_CONSOLE_USER=ben
DEV_CONSOLE_PASS=
